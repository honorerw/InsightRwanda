# Example only — copy to `.streamlit/secrets.toml` and fill in your own key.
# The real file is git-ignored. Never commit a live key.
#
# Create a key in the Groq console: https://console.groq.com/keys
GROQ_API_KEY = "replace-with-your-groq-api-key"

# Optional. Defaults to Groq's production GPT-OSS 120B model.
# Set this only after checking the current model catalogue and rate limits.
# GROQ_MODEL = "openai/gpt-oss-120b"
